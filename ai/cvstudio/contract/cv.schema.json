{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cvstudio:formatting:24.6.582",
  "title": "CV Studio derived formatting integration contract",
  "description": "Derived handover schema for the new ATS. Original CV Studio does not enforce this JSON Schema. Preserve supported extra fields rather than silently dropping them.",
  "type": "object",
  "required": [
    "candidate",
    "work_experiences",
    "education",
    "certifications",
    "skills"
  ],
  "properties": {
    "candidate": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "linkedin": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        },
        "industry_sub": {
          "type": "string"
        },
        "notice_period": {
          "type": "string"
        },
        "current_position": {
          "type": "string"
        },
        "current_company": {
          "type": "string"
        },
        "languages": {
          "type": "string"
        },
        "is_employed": {
          "type": "boolean"
        },
        "address": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "countryCode": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "summary_bullets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "work_experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date_range": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "section_heading": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "date_range": {
                  "type": "string"
                },
                "reason_for_leaving": {
                  "type": "string"
                },
                "bullets": {
                  "$ref": "#/$defs/bullets"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date_range": {
            "type": "string"
          },
          "institution": {
            "type": "string"
          },
          "degree": {
            "type": "string"
          },
          "cgpa": {
            "type": "string"
          },
          "major": {
            "type": "string"
          },
          "honors": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "item_layout": {
            "type": "array",
            "items": {
              "enum": [
                "heading",
                "nested",
                "bullet"
              ]
            }
          }
        },
        "additionalProperties": true
      }
    },
    "_document_alignment": {
      "enum": [
        "left",
        "justify"
      ]
    },
    "_summary_box_autofit": {
      "type": "boolean"
    },
    "_bullet_levels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "bullets": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "heading": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "bullets": {
                "$ref": "#/$defs/bullets"
              }
            },
            "required": [
              "heading"
            ],
            "additionalProperties": true
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
