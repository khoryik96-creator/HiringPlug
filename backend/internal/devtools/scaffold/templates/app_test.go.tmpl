// Generated by `task new:module` as a starting point; extend it as the module grows.
func Test[[.Plural]]CreateListAndIsolation(t *testing.T) {
	t.Parallel()
	a := newTestApp(t)
	tenant := testutil.Current.NewTenant(t, api.RoleRecruiter, api.RoleViewer)

	res := a.request(http.MethodPost, "/v1/[[.Path]]", tenant.Users[api.RoleRecruiter].Token, map[string]any{"name": "  First   one "})
	require.Equal(t, http.StatusCreated, res.Status, "%s", res.Body)
	var created api.[[.Entity]]
	res.JSON(&created)
	assert.Equal(t, "First one", created.Name)

	res = a.request(http.MethodPost, "/v1/[[.Path]]", tenant.Users[api.RoleViewer].Token, map[string]any{"name": "x"})
	assert.Equal(t, http.StatusForbidden, res.Status, "viewers may read but not create")

	var list api.[[.Entity]]List
	a.request(http.MethodGet, "/v1/[[.Path]]", tenant.Users[api.RoleViewer].Token, nil).JSON(&list)
	require.Len(t, list.Items, 1)

	other := testutil.Current.NewTenant(t, api.RoleOwner)
	a.request(http.MethodGet, "/v1/[[.Path]]", other.Users[api.RoleOwner].Token, nil).JSON(&list)
	assert.Empty(t, list.Items, "tenants never see each other's records")
}
