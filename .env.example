# Local settings. Copy to .env (git-ignored) and adjust; `task` loads it.
# Every variable the services read is listed here (tests check this).

# --- Go API and worker (backend/) ---
HP_ENV=development
HP_HTTP_ADDR=:8080
HP_SHUTDOWN_TIMEOUT=15s
# The restricted app role (row-level security applies). Created by `hp bootstrap`.
HP_DATABASE_URL=postgres://hp_api:hp_api_dev@localhost:5432/hiringplug?sslmode=disable
# The owner/admin role, used only by `hp` for migrations and setup.
HP_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/hiringplug?sslmode=disable
HP_LOG_LEVEL=info
HP_LOG_FORMAT=text
HP_AUTH_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
HP_AUTH_ISSUER=hiringplug
HP_AUTH_AUDIENCE=hiringplug-api
HP_FILES_DIR=./data/files
HP_FILES_URL_SECRET=dev-only-secret-change-me-0123456789abcdef
HP_INTERNAL_BASE_URL=http://localhost:8080
HP_MAX_UPLOAD_BYTES=10485760
# The header a reverse proxy names the client in (nginx in deploy/ sets X-Real-IP).
# Leave empty when the API is reached directly: clients could fake any header.
HP_CLIENT_IP_HEADER=
# Where people reach the web app; links in job feeds point here.
HP_PUBLIC_URL=http://localhost:5173
HP_DEFAULT_PHONE_REGION=MY
# Webhooks and careers pages on private or local network addresses (and
# webhooks over plain HTTP): only for trying them on your own machine; refused
# in production.
HP_ALLOW_PRIVATE_NETWORKS=false
# Where the company works: times in reminder emails are written in it.
HP_TIME_ZONE=Asia/Kuala_Lumpur
# Mail server for email from the app (host:port). Empty = emails are recorded
# but fail with "no mail server is set up". Local development: Mailpit from
# docker-compose (localhost:1025, TLS none; see the mail at http://localhost:8025).
HP_SMTP_HOST=localhost:1025
HP_SMTP_USERNAME=
HP_SMTP_PASSWORD=
HP_SMTP_FROM=no-reply@hiringplug.local
# starttls (default), tls (implicit, port 465) or none (local mail catchers only)
HP_SMTP_TLS=none

# --- Python AI worker (ai/) ---
# Its own role: may only call the job queue functions. Created by `hp bootstrap`.
HP_AI_DATABASE_URL=postgres://hp_ai:hp_ai_dev@localhost:5432/hiringplug?sslmode=disable
HP_AI_WORKER_ID=
HP_AI_OCR=on
# Tesseract languages, e.g. eng+msa for English and Malay (install the language packs).
HP_AI_OCR_LANGUAGES=eng
HP_AI_POLL_SECONDS=2
HP_AI_LEASE_SECONDS=600
# The AI assistant (sidebar and CV-job match). off = switched off. openai_compatible
# = any provider with an OpenAI-style chat API: DeepSeek's own API, a host
# running DeepSeek's open model in a region you choose, or your own server
# (vLLM, Ollama). Read by the API (on or off) and the AI worker.
HP_AI_PROVIDER=off
# e.g. https://api.deepseek.com/v1 (the address before /chat/completions)
HP_AI_PROVIDER_URL=
HP_AI_PROVIDER_KEY=
# e.g. deepseek-chat
HP_AI_MODEL=
HP_AI_TIMEOUT_SECONDS=90
# Tokens (question and answer) each company may use per calendar month.
HP_AI_MONTHLY_TOKENS=2000000

# --- Tests ---
# A superuser connection; tests create and drop their own databases.
HP_TEST_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
