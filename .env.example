# Local settings. Copy to .env (git-ignored) and adjust; `task` loads it.
# Every variable the services read is listed here (tests check this).

# --- Go API and worker (backend/) ---
HP_ENV=development
HP_HTTP_ADDR=:8080
HP_SHUTDOWN_TIMEOUT=15s
# How many background jobs the Go worker runs at once (emails, webhooks, saving AI results).
HP_WORKER_CONCURRENCY=4
# The restricted app role (row-level security applies). Created by `hp bootstrap`.
HP_DATABASE_URL=postgres://hp_api:hp_api_dev@localhost:5432/hiringplug?sslmode=disable
# The owner/admin role, used only by `hp` for migrations and setup.
HP_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/hiringplug?sslmode=disable
HP_LOG_LEVEL=info
HP_LOG_FORMAT=text
HP_AUTH_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
HP_AUTH_ISSUER=hiringplug
HP_AUTH_AUDIENCE=hiringplug-api
HP_FILES_DIR=./data/files
HP_FILES_URL_SECRET=dev-only-secret-change-me-0123456789abcdef
HP_INTERNAL_BASE_URL=http://localhost:8080
HP_MAX_UPLOAD_BYTES=10485760
# The header a reverse proxy names the client in (nginx in deploy/ sets X-Real-IP).
# Leave empty when the API is reached directly: clients could fake any header.
HP_CLIENT_IP_HEADER=
# Where people reach the web app; links in job feeds point here.
HP_PUBLIC_URL=http://localhost:5173

# Docker on a server only (deploy/.env; see docs/playbooks/deploy-to-a-server.md):
# the app's internet address (Caddy gets its HTTPS certificate for it, and
# HP_PUBLIC_URL becomes https://HP_DOMAIN), and the database passwords, set
# before the first start.
HP_DOMAIN=
HP_DB_ADMIN_PASSWORD=
HP_DB_API_PASSWORD=
HP_DB_AI_PASSWORD=
HP_DEFAULT_PHONE_REGION=MY
# Webhooks and careers pages on private or local network addresses (and
# webhooks over plain HTTP): only for trying them on your own machine; refused
# in production.
HP_ALLOW_PRIVATE_NETWORKS=false
# Where the company works: times in reminder emails are written in it.
HP_TIME_ZONE=Asia/Kuala_Lumpur
# Mail server for email from the app (host:port). Empty = emails are recorded
# but fail with "no mail server is set up". Local development: Mailpit from
# docker-compose (localhost:1025, TLS none; see the mail at http://localhost:8025).
HP_SMTP_HOST=localhost:1025
HP_SMTP_USERNAME=
HP_SMTP_PASSWORD=
HP_SMTP_FROM=no-reply@hiringplug.local
# starttls (default), tls (implicit, port 465) or none (local mail catchers only)
HP_SMTP_TLS=none
# Who is told when the server needs someone (a failed or late backup, a failed
# copy off the server, background work failing, a nearly full disk): the worker
# checks every 15 minutes and emails them. One address, or several with commas.
HP_ALERT_EMAIL=

# --- Python AI worker (ai/) ---
# Its own role: may only call the job queue functions. Created by `hp bootstrap`.
HP_AI_DATABASE_URL=postgres://hp_ai:hp_ai_dev@localhost:5432/hiringplug?sslmode=disable
HP_AI_WORKER_ID=
HP_AI_OCR=on
# Tesseract languages, e.g. eng+msa for English and Malay (install the language packs).
HP_AI_OCR_LANGUAGES=eng
HP_AI_POLL_SECONDS=2
HP_AI_LEASE_SECONDS=600
# How many AI-queue jobs run at once (reading CVs, AI questions, PDF copies).
HP_AI_CONCURRENCY=3
# Seals the AI provider API keys companies enter in Settings > AI provider
# (DeepSeek, Claude, ChatGPT). The API and the AI worker need the same value,
# at least 32 characters. Empty: keys cannot be saved there. Changing it makes
# saved keys unreadable (enter them again).
HP_AI_KEYS_SECRET=dev-only-ai-keys-secret-change-me-0123456789
# Seals the webhook signing secrets (Settings > Integrations) where the
# database keeps them, so a backup does not give them away. At least 32
# characters; empty keeps them as they are. Keep it: changing it makes saved
# webhooks stop signing (remove and add them again).
HP_WEBHOOK_KEYS_SECRET=dev-only-webhook-keys-secret-change-me-0123
# The server's own AI, used by companies that did not choose one in Settings
# (and by every company if HP_AI_KEYS_SECRET is empty). off = none. openai_compatible
# = any provider with an OpenAI-style chat API: DeepSeek's own API, a host
# running DeepSeek's open model in a region you choose, or your own server
# (vLLM, Ollama). Read by the API (on or off) and the AI worker.
HP_AI_PROVIDER=off
# e.g. https://api.deepseek.com/v1 (the address before /chat/completions)
HP_AI_PROVIDER_URL=
HP_AI_PROVIDER_KEY=
# e.g. deepseek-chat
HP_AI_MODEL=
HP_AI_TIMEOUT_SECONDS=90
# One long AI answer (CV Studio reads or anonymises a whole CV): a few
# minutes for a long CV. Must stay a minute under HP_AI_LEASE_SECONDS.
HP_AI_LONG_TIMEOUT_SECONDS=300
# Tokens (question and answer) each company may use per calendar month,
# the assistant and CV vs job matching together.
HP_AI_MONTHLY_TOKENS=2000000

# --- Tests ---
# A superuser connection; tests create and drop their own databases.
HP_TEST_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# --- Backups (hp backup) ---
# Where `hp backup` puts its copies of the database and files (Docker: the
# backups folder next to the repository), and how many to keep. Set it for the
# API too, to manage them in Settings > Backups (download, back up now, the
# nightly backup on or off).
HP_BACKUP_DIR=
HP_BACKUP_KEEP=14
# The agency (tenant id) that runs this server and may manage its backups (a
# backup holds every agency's data). Empty: the only agency, while there is one.
HP_BACKUP_TENANT=
# The user and group id (uid:gid) backups are handed to, when the backup
# service and the API run as different users (Docker: 65532:65532, the API's).
HP_BACKUP_OWNER=
# Off-site copies: after each backup, the backup service also copies it off
# this server, so losing the server does not lose the backups. Set either an
# S3-compatible bucket (Wasabi, Backblaze B2, AWS, Cloudflare R2, DigitalOcean
# Spaces...; the bucket may carry a folder, e.g. my-bucket/hiringplug; the
# endpoint is empty for AWS itself) with a key that may write to it, or a
# folder on another disk. Settings > System shows whether the copy went through.
# Bring one back on a new server: hp fetch, then hp restore.
HP_OFFSITE_S3_BUCKET=
HP_OFFSITE_S3_ENDPOINT=
HP_OFFSITE_S3_REGION=
HP_OFFSITE_S3_ACCESS_KEY=
HP_OFFSITE_S3_SECRET_KEY=
HP_OFFSITE_DIR=


# Mailbox connections: separate secret, stable across API/worker restarts.
# Empty disables storing user connections in production. At least 32 characters.
HP_MAIL_KEYS_SECRET=
# Registered web applications; see docs/mailbox-connections.md for redirects/scopes.
# Optional: owners and admins can enter these in Settings > Email connection instead.
HP_MAIL_MICROSOFT_CLIENT_ID=
HP_MAIL_MICROSOFT_CLIENT_SECRET=
HP_MAIL_GOOGLE_CLIENT_ID=
HP_MAIL_GOOGLE_CLIENT_SECRET=

# Claims storage (Settings > Claims storage): submitted receipts are uploaded to
# the company's Google Drive or OneDrive through the apps above, or to its
# Dropbox through this Dropbox app (redirect URL: <HP_PUBLIC_URL>/v1/claims/storage/callback;
# permissions account_info.read and files.content.write). See docs/claims-storage.md.
HP_DROPBOX_APP_KEY=
HP_DROPBOX_APP_SECRET=

# Optional Apollo work-email lookup in Find HR (see docs/apollo-hr.md).
HP_APOLLO_BROKER_URL=
HP_APOLLO_KEYS_SECRET=
